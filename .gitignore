# Git ignore for AI Learning Platform

# Environment variables - NEVER commit these
backend/.env
frontend/.env

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp
.tmp/
temp/
